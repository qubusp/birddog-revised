#!/bin/bash
# Replaced by two scripts, one per box (deploy/two-box.md):
#   sh/deploy-data [--dry-run] [host]   data box: migrations, code; never restarts
#                                       Postgres or Airflow without a --restart-* flag
#   sh/deploy-apps [--dry-run] [host]   apps box: code, image builds, docker compose up -d
# The old single-box script ran `docker compose up -d` on the data box, which
# recreates Postgres and Airflow whenever deploy/.env or their config changed.
cat >&2 <<'EOF'
sh/deploy is gone. Use, from the repo root:
  sh/deploy-data --dry-run    then  sh/deploy-data     (204.12.218.112: migrations + code)
  sh/deploy-apps --dry-run    then  sh/deploy-apps     (108.181.191.55: web app and UI tools)
See docs/onboarding/operations.md.
EOF
exit 2
