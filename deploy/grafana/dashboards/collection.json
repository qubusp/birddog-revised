    {
      "id": 13,
      "type": "table",
      "title": "Work queues",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Documents without location' AS queue, count(*) AS items FROM core.v_docs_no_location\nUNION ALL SELECT 'Documents without metadata', count(*) FROM core.v_docs_no_meta\nUNION ALL SELECT 'Documents needing duplicate check', count(*) FROM core.v_docs_need_dupe_check\nUNION ALL SELECT 'FTP files to match', count(*) FROM core.v_ftp_need_match\nUNION ALL SELECT 'Stale archive pages', count(*) FROM core.v_pages_stale\nUNION ALL SELECT 'Untranslated pages', count(*) FROM core.v_untranslated"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
