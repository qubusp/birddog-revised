    {
      "id": 7,
      "type": "timeseries",
      "title": "Documents by wiki upload month",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('month', wiki_timestamp) AS time, count(*) AS documents\nFROM core.document\nWHERE wiki_timestamp IS NOT NULL AND $__timeFilter(wiki_timestamp)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Archive pages changed on the wiki, by month",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('month', wiki_timestamp) AS time, count(*) AS pages\nFROM core.page\nWHERE wiki_timestamp IS NOT NULL AND $__timeFilter(wiki_timestamp)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Documents per archive",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(p.root_label, '(no page)') AS archive, count(DISTINCT pd.document_id) AS documents\nFROM core.page_document pd JOIN core.page p ON p.id = pd.page_id\nGROUP BY 1 ORDER BY 2 DESC LIMIT 20"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "barWidth": 0.8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#1f5f57"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Documents by processing code",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(nullif(process_code, ''), '(none)') AS code, count(*) AS documents\nFROM core.document GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
