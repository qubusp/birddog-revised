    },
    {
      "id": 7,
      "type": "stat",
      "title": "Cost per page",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 20,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(cost_usd), 0) / nullif(sum(pages_transcribed), 0) FROM views.books__transcription_progress"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "geomap",
      "title": "People per place (size and colour: register entries naming the place)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 14,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT location_name AS place, count(DISTINCT entry_id) AS people,\n       string_agg(DISTINCT event, ', ') AS events, string_agg(DISTINCT title, ' | ') AS books,\n       min(year) AS \"first year\", max(year) AS \"last year\", avg(latitude) AS latitude, avg(longitude) AS longitude\nFROM views.books__entry_places WHERE latitude IS NOT NULL\nGROUP BY location_id, location_name ORDER BY people"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 49.0,
          "lon": 30.5,
          "zoom": 5.4
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": true
        },
        "tooltip": {
          "mode": "details"
        },
        "basemap": {
          "type": "xyz",
          "name": "Light grey",
          "config": {
            "url": "https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}",
            "attribution": "Tiles &copy; Esri &mdash; Esri, HERE, Garmin, &copy; OpenStreetMap contributors"
          }
        },
        "layers": [
          {
            "type": "xyz",
            "name": "Place names",
            "tooltip": false,
            "config": {
              "url": "https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Reference/MapServer/tile/{z}/{y}/{x}",
              "attribution": "Tiles &copy; Esri &mdash; Esri, HERE, Garmin, &copy; OpenStreetMap contributors"
            }
          },
          {
            "type": "markers",
            "name": "Places",
            "tooltip": true,
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "field": "people",
                  "fixed": 3,
                  "min": 5,
                  "max": 26
                },
                "color": {
                  "field": "people",
                  "fixed": "#1d4e5f"
                },
                "opacity": 0.85,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            }
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d4a017",
                "value": null
              },
              {
                "color": "#d9622b",
                "value": 10
              },
              {
                "color": "#a3312a",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "Entries by event",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 14,
        "y": 13,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(event, '(none)') AS event, count(*) AS entries FROM views.books__entries GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Entries by year (where the year is known)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 14,
        "y": 21,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT year::text AS year, count(*) AS entries FROM views.books__entries\nWHERE year IS NOT NULL GROUP BY year ORDER BY year"
        }
      ],
      "options": {
        "orientation": "vertical",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "barWidth": 0.8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#1f5f57"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Register entries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT title AS book, page_no AS page, entry_no AS \"#\", event, date_text AS date, year, person, father, mother,\n       places, note, page_link\nFROM views.books__entries ORDER BY title, page_no, entry_no"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "page"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open",
                    "url": "${__data.fields.page_link}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Progress and cost per book",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT title, status, page_count AS pages, pages_transcribed AS transcribed, pages_reread AS \"re-read (Opus)\",\n       entries, round(cost_usd::numeric, 2) AS \"cost $\", round(cost_per_page::numeric, 3) AS \"$ per page\",\n       error, updated_at\nFROM views.books__transcription_progress ORDER BY updated_at DESC NULLS LAST"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
