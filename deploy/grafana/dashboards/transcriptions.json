    },
    {
      "id": 5,
      "type": "stat",
      "title": "People placed on the map",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT entry_id) FROM views.books__entry_places WHERE latitude IS NOT NULL"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
