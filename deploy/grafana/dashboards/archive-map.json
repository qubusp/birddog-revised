    {
      "id": 5,
      "type": "geomap",
      "title": "Locations (dots: every community; circles: named in the books, size and colour by mentions)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT name, region, c1900_province AS \"province (1900)\", c1900_district AS \"district (1900)\",\n       jewish_population AS \"Jewish population\", alternate_names AS \"other names\",\n       documents, latitude, longitude\nFROM views.map__locations WHERE books = 0"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT name, region, c1900_province AS \"province (1900)\", c1900_district AS \"district (1900)\",\n       jewish_population AS \"Jewish population\", books, book_mentions AS \"mentions in books\",\n       documents, latitude, longitude\nFROM views.map__locations WHERE books > 0 ORDER BY book_mentions"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 49.0,
          "lon": 30.5,
          "zoom": 5.4
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": true
        },
        "tooltip": {
          "mode": "details"
        },
        "basemap": {
          "type": "xyz",
          "name": "Light grey",
          "config": {
            "url": "https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}",
            "attribution": "Tiles &copy; Esri &mdash; Esri, HERE, Garmin, &copy; OpenStreetMap contributors"
          }
        },
        "layers": [
          {
            "type": "xyz",
            "name": "Place names",
            "tooltip": false,
            "config": {
              "url": "https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Reference/MapServer/tile/{z}/{y}/{x}",
              "attribution": "Tiles &copy; Esri &mdash; Esri, HERE, Garmin, &copy; OpenStreetMap contributors"
            }
          },
          {
            "type": "markers",
            "name": "Communities",
            "tooltip": true,
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": false,
              "style": {
                "size": {
                  "fixed": 3
                },
                "color": {
                  "fixed": "#1d4e5f"
                },
                "opacity": 0.45,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            }
          },
          {
            "type": "markers",
            "name": "Named in books",
            "tooltip": true,
            "filterData": {
              "id": "byRefId",
              "options": "B"
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "field": "mentions in books",
                  "fixed": 3,
                  "min": 5,
                  "max": 26
                },
                "color": {
                  "field": "mentions in books",
                  "fixed": "#1d4e5f"
                },
                "opacity": 0.85,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            }
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d4a017",
                "value": null
              },
              {
                "color": "#d9622b",
                "value": 10
              },
              {
                "color": "#a3312a",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Locations per region",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "birddog"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(region, '(none)') AS region, count(*) AS locations\nFROM views.map__locations GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "barWidth": 0.8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#1f5f57"
          }
        },
        "overrides": []
      }
    },
