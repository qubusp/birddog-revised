{
  "uid": "archive-map",
  "title": "Archive map",
  "description": "Every location in the catalog, from the NocoDB coordinates (migration 021). Size: how often the books name the place. Document counts fill in once documents are linked to places.",
  "tags": [
    "birddog"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timezone": "utc",
  "refresh": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Locations",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "birddog"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
