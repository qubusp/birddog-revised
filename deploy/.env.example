# deploy/.env: one per box, never in git (mode 600). This file lists the keys.
# sh/deploy-data and sh/deploy-apps add any missing key that can be random
# (values made on the server; empty secrets below are of that kind); keys
# marked "copy" must equal the other box's value. Comments go on their own
# line: the scripts read values verbatim. Every service on a box reads this
# file, so a change here makes `docker compose up -d` recreate them (on the
# data box: Postgres and Airflow, which need the owner's OK).
# See docs/onboarding/operations.md.

# --- both boxes ---------------------------------------------------------------
# selects the box's override (deploy/two-box.md):
#   data box: docker-compose.yml:docker-compose.databox.yml
#   apps box: docker-compose.yml:docker-compose.appsbox.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.databox.yml
# base domain Caddy serves: 204-12-218-112.sslip.io (data), 108-181-191-55.sslip.io (apps)
PUBLIC_DOMAIN=204-12-218-112.sslip.io

# --- data box: Postgres and Airflow -------------------------------------------
# generated; also used by the verify_restore DAG
POSTGRES_PASSWORD=
AIRFLOW_DB_PASSWORD=
# generated (owner role of the birddog database)
BIRDDOG_DB_PASSWORD=
# generated; encrypts Airflow connections, do not rotate casually
FERNET_KEY=
JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
# role passwords set on the data box (db/init/0*.sh); copy to the apps box
# generated on data box; copy to apps box (Mathesar, Saltcorn)
BIRDDOG_UI_DB_PASSWORD=
# generated on data box; copy to apps box (notebooks)
JUPYTER_DB_PASSWORD=
# generated on data box; copy to apps box (birddog-web)
BIRDDOG_WEB_DB_PASSWORD=
# data box: read-only role for the Marmot catalog (06-marmot-reader.sh)
MARMOT_READER_DB_PASSWORD=change-me
# data box, optional: Airflow lineage to the Marmot catalog (deploy/marmot/README.md).
# Read by the airflow-* containers only when they are created.
# AIRFLOW__OPENLINEAGE__NAMESPACE=birddog
# AIRFLOW__OPENLINEAGE__TRANSPORT='{"type":"http","url":"https://catalog.<apps domain>","endpoint":"api/v1/lineage","timeout":5,"auth":{"type":"api_key","apiKey":"<Marmot service-account key>"}}'
# postgres service env (02-ui.sh); the apps box has its own
MATHESAR_DB_PASSWORD=
# Airflow user the web app triggers DAG runs as (deploy/web/README.md); copy to apps box
AIRFLOW_API_USER=birddog-web
# generated on data box; copy to apps box
AIRFLOW_API_PASSWORD=

# Read by Airflow tasks (optional; a DAG that needs a missing one fails with a clear error)
# translate, app_translate_page: Google Cloud Translate
BIRDDOG_USE_GOOGLE_CLOUD_TRANSLATE=false
GOOGLE_TRANSLATE_API_KEY=
# source_jewishgen_sftp and match_ftp_documents (SFTP reads skip until this is set)
SFTP_PASSWORD=
# import_nocodb (dags/yaml/migration.yml, birddog/nocodb_import.py), one-off
NOCODB_IMPORT_TOKEN=
NOCODB_IMPORT_BASE=phb0w28bqvl85ki
# migrate_dynamodb_users (dags/yaml/migration_users.yml, birddog/dynamo_migrate.py), one-off
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
# locate_documents (dags/yaml/locations.yml, pool llm_api): Groq key for the LLM
# that extracts place names; unset = the DAG skips and documents stay pending.
# (birddog/locations/extractor.py PROVIDER_KEY_ENV; HF_TOKEN for provider "modal")
GROQ_LOCATION_KEY=
HF_TOKEN=

# --- apps box -----------------------------------------------------------------
# generated; superuser of apps-postgres (apps' metadata DBs)
APPS_POSTGRES_PASSWORD=
# Mathesar (deploy/ui/README.md)
MATHESAR_SECRET_KEY=
MATHESAR_ADMIN_USER=admin
MATHESAR_ADMIN_PASSWORD=
# JupyterHub (deploy/jupyterhub/README.md)
JUPYTERHUB_ADMIN_USER=admin
JUPYTERHUB_ADMIN_PASSWORD=
# BIRDDOG_HOST_REPO=/home/administrator/birddog-revised   (default; repo path on the host)
# ToolJet and Saltcorn (deploy/apps/README.md)
TOOLJET_DB_PASSWORD=
# generated; never rotate (encrypts saved datasource credentials)
TOOLJET_LOCKBOX_MASTER_KEY=
# generated (64 random bytes, hex); ToolJet does not start without it
TOOLJET_SECRET_KEY_BASE=
SALTCORN_DB_PASSWORD=
SALTCORN_SESSION_SECRET=
# Birddog web app (deploy/web/README.md)
# generated; Flask session signing key
BIRDDOG_SECRET_KEY=
# closed = invite only (python -m birddog.user_admin add); open = public signup
BIRDDOG_SIGNUP=closed
# password-reset mail (optional)
BIRDDOG_SMTP_SERVER=
BIRDDOG_SMTP_PORT=
BIRDDOG_SMTP_USERNAME=
BIRDDOG_SMTP_PASSWORD=
# the apps box keeps the data-box keys above blank (compose interpolates them)
