# Copy to deploy/.env and fill in. sh/deploy generates one with random values
# on the server if none exists.
POSTGRES_PASSWORD=
AIRFLOW_DB_PASSWORD=
BIRDDOG_DB_PASSWORD=
FERNET_KEY=
JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
# curator UI (Mathesar): see deploy/ui/README.md
BIRDDOG_UI_DB_PASSWORD=
MATHESAR_DB_PASSWORD=
MATHESAR_SECRET_KEY=
MATHESAR_ADMIN_USER=admin
MATHESAR_ADMIN_PASSWORD=
# public base domain served by Caddy (airflow.<domain>, data.<domain>)
PUBLIC_DOMAIN=204-12-218-112.sslip.io
# JupyterHub (deploy/jupyterhub/README.md): admin login + read-only DB role
JUPYTERHUB_ADMIN_USER=admin
JUPYTERHUB_ADMIN_PASSWORD=
JUPYTER_DB_PASSWORD=
# low-code app builders (deploy/apps/README.md): metadata DB roles + app secrets
TOOLJET_DB_PASSWORD=
TOOLJET_LOCKBOX_MASTER_KEY=
TOOLJET_SECRET_KEY_BASE=
SALTCORN_DB_PASSWORD=
SALTCORN_SESSION_SECRET=
# Birddog web app (deploy/web/README.md): Flask session key, DB role password,
# and the Airflow user it triggers DAG runs as
BIRDDOG_SECRET_KEY=
BIRDDOG_WEB_DB_PASSWORD=
AIRFLOW_API_USER=birddog-web
AIRFLOW_API_PASSWORD=
# NocoDB import (one-off, dags/import_nocodb.py)
NOCODB_IMPORT_TOKEN=
NOCODB_IMPORT_BASE=phb0w28bqvl85ki
